{
  "name": "1sync-file-manager",
  "version": "1.4.0",
  "description": "Better manage files related to records",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev:react": "npm run dev --prefix react",
    "build:react": "npm run build --prefix react",
    "build:salesforce": "npm run build:salesforce --prefix react",
    "test:react": "npm test --prefix react",
    "test:react:lwc": "sfdx-lwc-jest -- --testPathPattern=betterFiles",
    "test": "npm run test:unit",
    "test:unit": "sfdx-lwc-jest",
    "test:unit:watch": "sfdx-lwc-jest --watch",
    "test:unit:coverage": "sfdx-lwc-jest --coverage",
    "ts-build": "tsc",
    "preversion-create": "npm run build:salesforce",
    "version-create": "sf package version create --package \"Better Files By 1Sync\"  --code-coverage --installation-key-bypass --wait 10",
    "scan": "npm run build:salesforce && node scripts/scan.mjs"
  },
  "author": "jawills",
  "devDependencies": {
    "@salesforce/sfdx-lwc-jest": "^5.1.0",
    "prettier": "3.4.1",
    "prettier-plugin-apex": "2.2.2",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@salesforce/lightning-types": "^0.3.0"
  },
  "overrides": {
    "@lwc/engine-dom": "6.7.2",
    "@lwc/template-compiler": "6.7.2",
    "@lwc/compiler": "6.7.2",
    "@lwc/engine-core": "6.7.2",
    "@lwc/synthetic-shadow": "6.7.2",
    "@lwc/wire-service": "6.7.2"
  }
}
