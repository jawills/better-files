<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <masterLabel>Better File Manager</masterLabel>
    <targets>
        <target>lightning__RecordPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <supportedFormFactors>
                <supportedFormFactor type="Large" />
            </supportedFormFactors>
            <property name="accept" type="String"
                default=".pdf,.doc,.docx,.rtf,.txt,.xls,.xlsx,.csv,.ppt,.pptx,.jpg,.jpeg,.png,.gif,.zip"
                label="Accepted File Formats" />
            <property name="multiple" type="Boolean"
                default="true"
                label="Allow multiple file uploads at once" />
        </targetConfig>
    </targetConfigs>
    <isExposed>true</isExposed>
</LightningComponentBundle>